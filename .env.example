# Supabase project values for Next.js OAuth sign-in
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only allowlist for the one VIXEN platform-owner account.
# This is not a secret, but must never use a NEXT_PUBLIC_ prefix.
VIXEN_PLATFORM_ADMIN_EMAIL=admin@vixenvortex.com
